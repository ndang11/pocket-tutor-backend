generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id               String           @id @default(uuid())
  full_name        String?
  academic_system String?
  educationLevelId String?
  educationLevel  EducationLevel? @relation(fields: [educationLevelId], references: [id])
  streamId        String?
  stream         Stream?         @relation(fields: [streamId], references: [id])
  documents      Documentation[]
  flashcards     Flashcard[]
  created_at     DateTime         @default(now())
  @@map("profiles")
}

model Documentation {
  id              String            @id @default(uuid())
  title           String
  path            String
  userId          String
  created_at      DateTime          @default(now())
  document_chunks document_chunks[]
  profile         Profile           @relation(fields: [userId], references: [id], onDelete: Cascade)

  flashcards Flashcard[]
  @@map("documents") 
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model document_chunks {
  id          String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  document_id String
  user_id     String
  chunk_index Int
  content     String
  embedding   Unsupported("vector(3072)")?
  created_at  DateTime?              @default(now()) @db.Timestamptz(6)
  documents   Documentation          @relation(fields: [document_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([document_id, chunk_index])
}

model Flashcard {
  id         String   @id @default(uuid())
  front      String   @db.Text
  back       String   @db.Text
  documentId String
  userId     String
  created_at DateTime @default(now())
  document   Documentation @relation(fields: [documentId], references: [id], onDelete: Cascade)
  profile    Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("flashcards")
}

model EducationLevel {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  order       Int
  description String?
  streams     Stream[]
  profiles   Profile[]
  created_at  DateTime   @default(now())
  @@map("education_levels")
}

model Stream {
  id               String          @id @default(uuid())
  name             String
  slug             String        @unique
  description     String?
  educationLevelId String
  educationLevel  EducationLevel @relation(fields: [educationLevelId], references: [id], onDelete: Cascade)
  subjects         Subject[]
  profiles        Profile[]
  @@map("streams")
}

model Subject {
  id       String @id @default(uuid())
  name     String
  slug     String
  streamId String
  stream   Stream  @relation(fields: [streamId], references: [id], onDelete: Cascade)
  @@map("subjects")
}

model StudyHistory {
  id              String   @id @default(uuid())
  userId          String
  type            String
  title           String
  description     String?
  duration        Int?
  score           Int?
  totalQuestions  Int?
  correctAnswers  Int?
  documentId      String?
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("study_history")
}